{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "esnext"],
    "jsx": "react-native",
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["jest", "react-native", "react"],
    "resolveJsonModule": true,
    "allowJs": true
  },
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js"]
}
