      "bundleIdentifier": "com.komugi.offhabit"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F0"
      }
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    }
  }
}
