{
  "expo": {
    "name": "こむぎOFF習慣",
    "slug": "komugi-off-habit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
